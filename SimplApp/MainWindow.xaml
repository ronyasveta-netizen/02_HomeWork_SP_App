<Window x:Class="SimplApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimplApp"
        mc:Ignorable="d"
        Title="02_HomeWork_Thread" Height="450" Width="800">
    <Grid Background="LightYellow" Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="81"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="423*"/>
            <ColumnDefinition Width="367*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Enter start and end of range below:" FontSize="16" Margin="20,10,10,10" FontWeight="Bold"/>

        <TextBlock Grid.Row="0" Grid.Column="1" Text="Click the 'Start process' button" FontSize="16" FontWeight="Bold" Margin="20,10,10,10" TextWrapping="Wrap"/>
        <!--   -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="20,20,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="FROM" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="StartBox" Grid.Column="1" Margin="5,5,110,5" Padding="2" Background="#FFD0C3C3"/>

            <TextBlock Text="TO" Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold" RenderTransformOrigin="-4.436,0.641"/>
            <TextBox x:Name="EndBox" Grid.Column="3" Margin="5,5,58,5" Background="#FFB39999" Padding="2"/>
        </Grid>
        <!--  -->
        <Button Click="Start" Grid.Row="1" Grid.Column="1" Content="START" FontSize="24" Background="#FF72E21A" HorizontalAlignment="Left" VerticalAlignment="Center" Width="286" Height="41" Margin="20" FontWeight="Bold" />
        <!--  -->
        <ListBox x:Name="PrimeList" Grid.Row="2" Grid.Column="0" Margin="20" Padding="5" Background="#FFF0EAEA" FontSize="16"/>
        <ListBox x:Name="FibonacciList" Grid.Row="2" Grid.Column="1" Margin="20" Padding="5" Background="#FFEAEAF0" FontSize="16"/>
                 

    </Grid>
</Window>
